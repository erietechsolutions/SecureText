{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SecureText",
  "version": "0.1.0",
  "identifier": "com.erietechsolutions.securetext",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SecureText",
        "width": 1200,
        "height": 780,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "erietechsolutions",
    "homepage": "https://github.com/erietechsolutions/SecureText",
    "license": "MIT OR Apache-2.0",
    "category": "SocialNetworking",
    "shortDescription": "Anonymous, end-to-end encrypted chat over Tor",
    "longDescription": "SecureText is a Discord-style messenger with no accounts and no central server. Every message is end-to-end encrypted (MLS) and travels only over Tor onion services, so nobody can read it or tell who is talking to whom.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "linux": {
      "deb": {
        "section": "net"
      },
      "rpm": {
        "release": "1"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}

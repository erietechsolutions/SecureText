#!/bin/sh
set -e
if [ "$1" = "configure" ] && [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable --now securetext-relay.service >/dev/null 2>&1 || true
    echo "securetext-relay: started. Its address appears in /var/lib/securetext-relay/address once Tor is up."
fi
exit 0
